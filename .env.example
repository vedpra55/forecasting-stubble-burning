# Copy to .env (git-ignored) or set as environment variables/secrets.
GEE_PROJECT=your-gcp-project-id
# Path to a service-account JSON key registered for Earth Engine on GEE_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Alternatively, the key JSON itself (useful for cloud secrets)
GEE_SERVICE_ACCOUNT_KEY=
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
LSASAF_USER=
LSASAF_PASSWORD=
